<UserControl x:Class="WaNut.App.Views.StepsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <!--
    The loading strip of a long job (StepsViewModel): "02 / 05" and the step's title, one line on what happens now,
    and a row of circles joined by a line that fills as the job moves on. The current circle is filled dark, the
    ones behind it are outlined dark, the ones ahead stay grey. Colors fade between states as layers (design.md 6).
  -->
  <UserControl.Resources>
    <FontFamily x:Key="StepGlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  </UserControl.Resources>

  <StackPanel AutomationProperties.LiveSetting="Polite">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding Number}" FontFamily="Consolas" FontWeight="Bold" FontSize="{StaticResource FontTitle}"
                 VerticalAlignment="Center" />
      <TextBlock Style="{StaticResource MutedText}" FontFamily="Consolas" FontSize="{StaticResource FontSmall}"
                 Margin="3,0,12,0" VerticalAlignment="Center">
        <Run Text="/" /> <Run Text="{Binding Total, Mode=OneWay}" />
      </TextBlock>
      <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeadingFont}" FontSize="{StaticResource FontSubheading}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 AutomationProperties.Name="{Binding Title}" />
    </StackPanel>
    <TextBlock Text="{Binding Help}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />

    <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,0" Focusable="False" IsTabStop="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel AutomationProperties.Name="{Binding Label}">
            <Grid Height="36">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- The line into this circle (left half) and on to the next one (right half); the dark part grows over the grey. -->
              <Border x:Name="LineIn" Height="2" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" />
              <Border x:Name="LineInFill" Height="2" VerticalAlignment="Center" Background="{DynamicResource TextBrush}"
                      RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                  <ScaleTransform ScaleX="0" />
                </Border.RenderTransform>
              </Border>
              <Border x:Name="LineOut" Grid.Column="1" Height="2" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" />
              <Border x:Name="LineOutFill" Grid.Column="1" Height="2" VerticalAlignment="Center" Background="{DynamicResource TextBrush}"
                      RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                  <ScaleTransform ScaleX="0" />
                </Border.RenderTransform>
              </Border>

              <Grid Grid.ColumnSpan="2" Width="36" Height="36" HorizontalAlignment="Center">
                <Ellipse Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.5" />
                <Ellipse x:Name="Reached" Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Opacity="0" />
                <Ellipse x:Name="Current" Fill="{DynamicResource TextBrush}" Opacity="0" />
                <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource StepGlyphFont}"
                           FontSize="{StaticResource FontSubheading}" Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Grid>
            <TextBlock x:Name="Label" Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="{StaticResource FontSmall}"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,6,3,0" />
          </StackPanel>

          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsFirst}" Value="True">
              <Setter TargetName="LineIn" Property="Visibility" Value="Hidden" />
              <Setter TargetName="LineInFill" Property="Visibility" Value="Hidden" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLast}" Value="True">
              <Setter TargetName="LineOut" Property="Visibility" Value="Hidden" />
              <Setter TargetName="LineOutFill" Property="Visibility" Value="Hidden" />
            </DataTrigger>

            <!-- Reached: the line in fills, the circle and icon turn dark. -->
            <DataTrigger Binding="{Binding IsReached}" Value="True">
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrush}" />
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LineInFill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1"
                                     Duration="{StaticResource MotionTransition}" EasingFunction="{StaticResource MotionEase}" />
                    <DoubleAnimation Storyboard.TargetName="Reached" Storyboard.TargetProperty="Opacity" To="1"
                                     Duration="{StaticResource MotionTransition}" EasingFunction="{StaticResource MotionEase}" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LineInFill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0" />
                    <DoubleAnimation Storyboard.TargetName="Reached" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>

            <!-- Done: the line on to the next circle fills too. -->
            <DataTrigger Binding="{Binding IsDone}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LineOutFill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1"
                                     Duration="{StaticResource MotionTransition}" EasingFunction="{StaticResource MotionEase}" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LineOutFill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>

            <!-- Current: a filled dark circle with a light icon, and a bold label. -->
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource CardBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}" />
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Current" Storyboard.TargetProperty="Opacity" To="1"
                                     Duration="{StaticResource MotionTransition}" EasingFunction="{StaticResource MotionEase}" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Current" Storyboard.TargetProperty="Opacity" To="0"
                                     Duration="{StaticResource MotionTransition}" EasingFunction="{StaticResource MotionEase}" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
