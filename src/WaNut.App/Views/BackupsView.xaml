<UserControl x:Class="WaNut.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources"
             xmlns:controls="clr-namespace:WaNut.App.Controls">
  <!-- DataContext: BackupsViewModel -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="Item" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <!-- A plain list: no selection of its own, but each row is a list item screen readers can enter. -->
    <Style x:Key="PlainList" TargetType="ListBox">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ItemsPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="4,4,16,16">
      <!-- Actions -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="{res:Text Backups_BackUpNow}" Command="{Binding BackUpNowCommand}" MinWidth="110" />
        <Button Content="{res:Text Backups_OpenFolder}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
      </StackPanel>
      <TextBlock Text="{res:Text Backups_Hint}" Style="{StaticResource Hint}" Margin="0,0,0,14" />

      <Border Style="{StaticResource NoticeBanner}" Margin="0,0,0,14"
              Visibility="{Binding ShowStopToChange, Converter={StaticResource Visible}}">
        <TextBlock Text="{res:Text Backups_StopToChange}" TextWrapping="Wrap" />
      </Border>

      <!-- Working: the peanut wobbles while the zip is written or read. -->
      <StackPanel Margin="0,0,0,14" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Image Style="{StaticResource BusyPeanut}" Width="22" Height="22" Margin="0,0,8,0" />
          <TextBlock Text="{Binding WorkText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding WorkFraction, Mode=OneWay}" Height="6"
                     AutomationProperties.Name="{Binding WorkText}" />
      </StackPanel>

      <!-- Success: the peanut cheers. -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding DoneText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <controls:PixelScene Scene="backup-done" Width="32" Height="32" Margin="0,0,8,0" />
        <TextBlock Text="{Binding DoneText}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>

      <!-- Errors: plain wording, no peanut (decision 16). -->
      <Border Margin="0,0,0,14">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
      </Border>

      <!-- Backup list -->
      <TextBlock Text="{Binding TotalSizeText}" Style="{StaticResource SectionCaption}" Margin="0,0,0,8" />
      <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" AutomationProperties.Name="{res:Text Server_TabBackups}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{res:Text Backups_Restore}" Padding="10,3" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding RestoreLabel}"
                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />
                <StackPanel>
                  <TextBlock Text="{Binding DateText}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                    <Run Text="{Binding ReasonText, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding SizeText, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- No backups yet -->
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Items.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <controls:PixelScene Scene="no-backups" Width="64" Height="64" Margin="0,0,10,0" VerticalAlignment="Top" />
        <StackPanel MaxWidth="480">
          <TextBlock Text="{res:Text Backups_Empty}" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{res:Text Backups_EmptyHint}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>

      <!-- More settings: the cleanup rules, shared by every server -->
      <Expander Header="{res:Text Settings_MoreSettings}" Margin="-4,24,0,0">
        <StackPanel Margin="4,8,0,0">
          <StackPanel Style="{StaticResource Item}">
            <TextBlock Text="{res:Text Backups_KeepCount}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding App.BackupKeepCount}" MaxLength="3" Width="80" HorizontalAlignment="Left"
                     AutomationProperties.Name="{res:Text Backups_KeepCount}" InputMethod.IsInputMethodEnabled="False" />
            <TextBlock Text="{res:Text Backups_KeepCountHint}" Style="{StaticResource Hint}" />
          </StackPanel>
          <StackPanel Style="{StaticResource Item}">
            <TextBlock Text="{res:Text Backups_MaxAgeDays}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding App.BackupMaxAgeDays}" MaxLength="4" Width="80" HorizontalAlignment="Left"
                     AutomationProperties.Name="{res:Text Backups_MaxAgeDays}" InputMethod.IsInputMethodEnabled="False" />
            <TextBlock Text="{res:Text Backups_MaxAgeDaysHint}" Style="{StaticResource Hint}" />
          </StackPanel>
          <TextBlock Text="{res:Text Backups_RulesShared}" Style="{StaticResource Hint}" Margin="0,-6,0,0" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
