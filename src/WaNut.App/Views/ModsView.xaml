<UserControl x:Class="WaNut.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources">
  <!-- DataContext: ModsViewModel -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <!-- A plain list: no selection of its own, but each row is a list item screen readers can enter. -->
    <Style x:Key="PlainList" TargetType="ListBox">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ItemsPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="4,4,16,16">
      <!-- Vanilla: nothing to install, say how to get there. -->
      <TextBlock Text="{res:Text Mods_Vanilla}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSupported}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <StackPanel Visibility="{Binding IsSupported, Converter={StaticResource Visible}}">
        <Border Style="{StaticResource NoticeBanner}" Margin="0,0,0,14"
                Visibility="{Binding ShowStopToChange, Converter={StaticResource Visible}}">
          <TextBlock Text="{res:Text Mods_StopToChange}" TextWrapping="Wrap" />
        </Border>

        <!-- Working: the peanut wobbles while files download. -->
        <StackPanel Margin="0,0,0,14" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Image Style="{StaticResource BusyPeanut}" Width="22" Height="22" Margin="0,0,8,0" />
            <TextBlock Text="{Binding WorkText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding WorkFraction, Mode=OneWay}" Height="6"
                       AutomationProperties.Name="{Binding WorkText}" />
        </StackPanel>

        <TextBlock Text="{Binding DoneText}" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding DoneText}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- Errors: plain wording, no peanut (decision 16). -->
        <Border Margin="0,0,0,14">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Border>

        <!-- Installed -->
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="{res:Text Mods_OpenFolder}" Command="{Binding OpenFolderCommand}" Padding="10,3" />
          <TextBlock Text="{Binding InstalledHeader}" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Installed}" AutomationProperties.Name="{Binding InstalledHeader}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{res:Text Mods_Remove}" Padding="10,3" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding RemoveLabel}"
                          Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Margin="0,4,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Installed.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{Binding EmptyText}" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{res:Text Mods_EmptyHint}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Find on Modrinth -->
        <TextBlock Text="{Binding FindHeader}" Style="{StaticResource SectionCaption}" Margin="0,28,0,8" />
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Text Mods_SearchBox}">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Grid.Column="1" Content="{res:Text Mods_Search}" Command="{Binding SearchCommand}" Margin="8,0,0,0" MinWidth="80" />
        </Grid>
        <TextBlock Text="{Binding FilterText}" Style="{StaticResource Hint}" Margin="0,0,0,10" />

        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Results}" AutomationProperties.Name="{Binding FindHeader}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="{res:Text Mods_Page}" Padding="10,3" Margin="0,0,6,0"
                            AutomationProperties.Name="{Binding PageLabel}"
                            Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" />
                    <Grid MinWidth="80">
                      <Button Content="{res:Text Mods_Install}" Padding="10,3"
                              AutomationProperties.Name="{Binding InstallLabel}"
                              Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <TextBlock Text="{res:Text Mods_Installed}" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                 Visibility="{Binding IsInstalled, Converter={StaticResource Visible}}" />
                    </Grid>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{res:Text Mods_Searching}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Visibility="{Binding IsSearching, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{res:Text Mods_NoResults}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Visibility="{Binding ShowNoResults, Converter={StaticResource Visible}}" />
        <Button Content="{res:Text Mods_LoadMore}" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                Visibility="{Binding CanLoadMore, Converter={StaticResource Visible}}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
