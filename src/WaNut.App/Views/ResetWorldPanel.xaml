<UserControl x:Class="WaNut.App.Views.ResetWorldPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources"
             xmlns:controls="clr-namespace:WaNut.App.Controls">
  <!-- Deletes the world (after a backup), so plain wording and Cancel as the default button. Shown with InlinePanel. -->
  <StackPanel>
    <TextBlock Text="{res:Text Reset_Title}" FontSize="{StaticResource FontTitle}" FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold" />
    <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontSize="{StaticResource FontSubheading}" Margin="0,12,0,0" />

    <TextBlock Text="{res:Text Reset_SeedLabel}" FontWeight="SemiBold" Margin="0,18,0,6" />
    <TextBox x:Name="SeedBox" MaxLength="64" AutomationProperties.Name="{res:Text Reset_SeedLabel}" />
    <TextBlock Text="{res:Text Reset_SeedHint}" Style="{StaticResource MutedText}" FontSize="{StaticResource FontSmall}" TextWrapping="Wrap" Margin="0,3,0,0" />

    <Border Style="{StaticResource NoticeBanner}" Margin="0,18,0,0">
      <TextBlock Text="{res:Text Reset_BackupNote}" TextWrapping="Wrap" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{res:Text Reset_Confirm}" MinWidth="80" Margin="0,0,6,0" controls:InlinePanel.Answer="True" />
      <Button Content="{res:Text Common_Cancel}" MinWidth="80" controls:InlinePanel.Answer="False"
              controls:InlinePanel.IsDefault="True" controls:InlinePanel.TakesFocus="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
