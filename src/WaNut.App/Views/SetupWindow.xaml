<Window x:Class="WaNut.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WaNut.App.Resources"
        Title="{res:Text Setup_Title}"
        Icon="pack://application:,,,/Assets/wanut.ico"
        Style="{StaticResource AppWindow}"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <!-- DataContext: SetupViewModel -->
  <StackPanel Margin="24">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
      <Image Style="{StaticResource Peanut}" Width="40" Height="40" Margin="0,0,12,0" />
      <TextBlock Text="{res:Text Setup_Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Text="{res:Text Setup_Intro}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,20" />

    <CheckBox Content="{res:Text Setup_DesktopShortcut}" IsChecked="{Binding DesktopShortcut}" />

    <StackPanel Margin="0,18,0,0">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Style.Triggers>
            <DataTrigger Binding="{Binding CanChooseFolder}" Value="False">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <TextBlock Text="{res:Text Setup_ServersFolder}" Margin="0,0,0,6" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{res:Text Setup_Browse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
        <TextBox Text="{Binding InstancesDir}" IsReadOnly="True" VerticalContentAlignment="Center" />
      </DockPanel>
      <TextBlock Text="{res:Text Setup_ServersFolderHint}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>

    <CheckBox Content="{res:Text Update_CheckOnStart}" IsChecked="{Binding CheckForUpdates}" Margin="0,18,0,0" />
    <TextBlock Text="{res:Text Update_CheckOnStartHint}" Style="{StaticResource MutedText}"
               FontSize="12" TextWrapping="Wrap" Margin="26,2,0,0" />

    <Border Margin="0,14,0,0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
    </Border>

    <Button Content="{res:Text Setup_Finish}" Command="{Binding FinishCommand}" IsDefault="True"
            HorizontalAlignment="Right" MinWidth="100" Margin="0,24,0,0" />
  </StackPanel>
</Window>
