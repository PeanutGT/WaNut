<Window x:Class="WaNut.App.Views.CreateServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WaNut.App.Resources"
        Title="{res:Text CreateServer_Title}"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="24">
    <TextBlock Text="{res:Text CreateServer_Title}" FontSize="20" FontWeight="Bold" />

    <TextBlock Text="{res:Text CreateServer_NameLabel}" Style="{StaticResource FieldLabel}" />
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
             IsEnabled="{Binding IsIdle}"
             Padding="6,4" />

    <TextBlock Text="{res:Text CreateServer_TypeLabel}" Style="{StaticResource FieldLabel}" />
    <TextBlock Text="{res:Text CreateServer_TypeVanilla}" Foreground="{StaticResource MutedTextBrush}" />

    <TextBlock Text="{res:Text CreateServer_VersionLabel}" Style="{StaticResource FieldLabel}" />
    <ComboBox ItemsSource="{Binding Versions}"
              SelectedItem="{Binding SelectedVersion}"
              DisplayMemberPath="Id"
              IsEnabled="{Binding IsIdle}"
              Padding="6,4" />

    <DockPanel Margin="0,14,0,6">
      <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" FontWeight="SemiBold" />
      <TextBlock Text="{res:Text CreateServer_MemoryLabel}" FontWeight="SemiBold" />
    </DockPanel>
    <Slider Minimum="{Binding MinMemoryMb}"
            Maximum="{Binding MaxMemoryMb}"
            Value="{Binding MemoryMb}"
            TickFrequency="{Binding MemoryStepMb}"
            SmallChange="{Binding MemoryStepMb}"
            LargeChange="{Binding MemoryStepMb}"
            IsSnapToTickEnabled="True"
            IsEnabled="{Binding IsIdle}" />
    <TextBlock Text="{res:Text CreateServer_MemoryHint}"
               Foreground="{StaticResource MutedTextBrush}"
               TextWrapping="Wrap" Margin="0,4,0,0" />

    <CheckBox IsChecked="{Binding EulaAccepted}" IsEnabled="{Binding IsIdle}" Margin="0,18,0,0">
      <TextBlock TextWrapping="Wrap">
        <Run Text="{res:Text CreateServer_EulaPrefix}" />
        <Hyperlink Command="{Binding OpenEulaCommand}"><Run Text="{res:Text CreateServer_EulaLink}" /></Hyperlink>
      </TextBlock>
    </CheckBox>

    <StackPanel Margin="0,18,0,0"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding StatusText}" Margin="0,0,0,6" />
      <ProgressBar Height="8"
                   Value="{Binding ProgressPercent, Mode=OneWay}"
                   IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
    </StackPanel>

    <TextBlock Text="{Binding ErrorText}"
               Foreground="#B91C1C"
               TextWrapping="Wrap"
               Margin="0,12,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{res:Text Common_Cancel}"
              Command="{Binding CancelCommand}"
              Padding="14,8" Margin="0,0,8,0" />
      <Button Content="{res:Text CreateServer_Create}"
              Command="{Binding CreateCommand}"
              Style="{StaticResource PrimaryButton}"
              IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
