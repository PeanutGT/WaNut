<Window x:Class="WaNut.App.Views.CreateServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WaNut.App.Resources"
        xmlns:controls="clr-namespace:WaNut.App.Controls"
        xmlns:views="clr-namespace:WaNut.App.Views"
        Title="{res:Text CreateServer_Title}"
        Icon="pack://application:,,,/Assets/wanut.ico"
        Style="{StaticResource AppWindow}"
        Width="520" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
  </Window.Resources>

  <!-- On a short screen the form scrolls, and Cancel/Create stay visible below it. -->
  <DockPanel Margin="24,24,24,24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{res:Text Common_Cancel}"
              Command="{Binding CancelCommand}"
              MinWidth="80" Margin="0,0,8,0" />
      <Button Content="{res:Text CreateServer_Create}"
              Command="{Binding CreateCommand}"
              Style="{StaticResource PrimaryButton}"
              MinWidth="80"
              IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Image Style="{StaticResource Peanut}" Width="28" Height="28" Margin="0,0,10,0" />
          <TextBlock Text="{res:Text CreateServer_Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{res:Text CreateServer_WorldLabel}" Style="{StaticResource FieldLabel}" />
        <ListBox ItemsSource="{Binding WorldChoices}"
                 SelectedItem="{Binding SelectedWorldChoice}"
                 IsEnabled="{Binding IsIdle}"
                 AutomationProperties.Name="{res:Text CreateServer_WorldLabel}"
                 Background="{DynamicResource CardBrush}"
                 BorderThickness="1"
                 Padding="4">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
              <Setter Property="Padding" Value="10,7" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Visibility="{Binding IsImport, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{res:Text World_PickLabel}" Style="{StaticResource FieldLabel}" />
          <views:WorldPicker DataContext="{Binding Picker}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>

        <!-- A modpack decides the type and version, so those lists are locked while it is chosen. -->
        <StackPanel Visibility="{Binding IsModpack, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{res:Text Modpack_PickLabel}" Style="{StaticResource FieldLabel}" />
          <Button Content="{res:Text Modpack_Pick}"
                  Command="{Binding PickModpackCommand}"
                  IsEnabled="{Binding IsIdle}"
                  HorizontalAlignment="Left" Padding="12,4" />
          <TextBlock Text="{Binding ModpackSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Text="{res:Text Modpack_Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <Border Margin="0,8,0,0">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ModpackError}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding ModpackError}" TextWrapping="Wrap" />
          </Border>
          <Border Style="{StaticResource WarningBanner}" Margin="0,8,0,0"
                  Visibility="{Binding ModpackVersionMissing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ModpackVersionMissingText}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>

        <TextBlock Text="{res:Text CreateServer_NameLabel}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{res:Text CreateServer_NameLabel}"
                 IsEnabled="{Binding IsIdle}" />

        <TextBlock Text="{res:Text CreateServer_TypeLabel}" Style="{StaticResource FieldLabel}" />
        <ListBox ItemsSource="{Binding ServerTypes}"
                 SelectedItem="{Binding SelectedType}"
                 IsEnabled="{Binding CanPickTypeAndVersion}"
                 AutomationProperties.Name="{res:Text CreateServer_TypeLabel}"
                 Background="{DynamicResource CardBrush}"
                 BorderThickness="1"
                 Padding="4">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
              <Setter Property="Padding" Value="10,7" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <controls:PixelScene Scene="{Binding Scene}" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{res:Text CreateServer_VersionLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Versions}"
                  SelectedItem="{Binding SelectedVersion}"
                  DisplayMemberPath="Id"
                  IsEnabled="{Binding CanPickTypeAndVersion}" />

        <!-- Going back to an older version than the world's: a plain warning and a second, deliberate tick. -->
        <Border Style="{StaticResource WarningBanner}" Margin="0,10,0,0"
                Visibility="{Binding ShowNewerWorldWarning, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding NewerWorldWarningText}" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding NewerWorldAccepted}" IsEnabled="{Binding IsIdle}" Margin="0,10,0,0">
              <TextBlock Text="{res:Text World_NewerAccept}" TextWrapping="Wrap" />
            </CheckBox>
          </StackPanel>
        </Border>

        <DockPanel Margin="0,14,0,6">
          <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryText}" FontWeight="SemiBold" />
          <TextBlock Text="{res:Text CreateServer_MemoryLabel}" FontWeight="SemiBold" />
        </DockPanel>
        <Slider Minimum="{Binding MinMemoryMb}"
                Maximum="{Binding MaxMemoryMb}"
                Value="{Binding MemoryMb}"
                TickFrequency="{Binding MemoryStepMb}"
                SmallChange="{Binding MemoryStepMb}"
                LargeChange="{Binding MemoryStepMb}"
                IsSnapToTickEnabled="True"
                IsEnabled="{Binding IsIdle}" />
        <TextBlock Text="{res:Text CreateServer_MemoryHint}"
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap" Margin="0,4,0,0" />

        <TextBlock Text="{res:Text CreateServer_OwnerLabel}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}"
                 Tag="{res:Text CreateServer_OwnerPlaceholder}"
                 AutomationProperties.Name="{res:Text CreateServer_OwnerLabel}"
                 AutomationProperties.HelpText="{res:Text CreateServer_OwnerHint}"
                 MaxLength="16" InputMethod.IsInputMethodEnabled="False"
                 IsEnabled="{Binding IsIdle}" />
        <TextBlock Text="{res:Text CreateServer_OwnerHint}"
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock Text="{res:Text Players_InvalidName}"
                   Foreground="{DynamicResource ErrorTextBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding OwnerNameInvalid, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsImport, Converter={StaticResource BoolToVisibility}}">
          <CheckBox IsChecked="{Binding BringInventory}" IsEnabled="{Binding CanBringInventory}">
            <TextBlock Text="{res:Text World_BringInventory}" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Text="{res:Text World_BringInventoryNeedsName}" TextWrapping="Wrap" Margin="26,4,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CanBringInventory}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <!-- More settings: only for a world the server generates; an imported world keeps its own seed and terrain. -->
        <Expander Header="{res:Text Settings_MoreSettings}" Margin="-4,18,0,0">
          <Expander.Style>
            <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsImport}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Expander.Style>
          <StackPanel Margin="4,0,0,0">
            <TextBlock Text="{res:Text Game_Seed}" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{res:Text Game_Seed}"
                     AutomationProperties.HelpText="{res:Text Game_SeedHint}"
                     IsEnabled="{Binding IsIdle}" />
            <TextBlock Text="{res:Text Game_SeedHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="{res:Text CreateServer_WorldTypeLabel}" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding WorldTypes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding WorldType}"
                      AutomationProperties.Name="{res:Text CreateServer_WorldTypeLabel}"
                      IsEnabled="{Binding IsIdle}" Width="220" HorizontalAlignment="Left" />

            <StackPanel Visibility="{Binding IsSuperflat, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{res:Text CreateServer_FlatPresetLabel}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding FlatPresets}" DisplayMemberPath="Label" SelectedValuePath="Value"
                        SelectedValue="{Binding FlatPreset}"
                        AutomationProperties.Name="{res:Text CreateServer_FlatPresetLabel}"
                        IsEnabled="{Binding IsIdle}" Width="220" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </Expander>

        <!-- Advanced mode only: plain wording, no peanut (decision 16). -->
        <StackPanel Margin="0,18,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding App.AdvancedMode}" Value="True" />
                    <Condition Binding="{Binding IsSuperflat}" Value="True" />
                    <Condition Binding="{Binding IsImport}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{res:Text Settings_AdvancedSection}" Style="{StaticResource SectionCaption}" Margin="0,0,0,6" />
          <TextBlock Text="{res:Text CreateServer_CustomGenerator}" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBox Text="{Binding CustomGenerator, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160"
                   VerticalScrollBarVisibility="Auto"
                   AutomationProperties.Name="{res:Text CreateServer_CustomGenerator}"
                   AutomationProperties.HelpText="{res:Text CreateServer_CustomGeneratorHint}"
                   InputMethod.IsInputMethodEnabled="False"
                   IsEnabled="{Binding IsIdle}" />
          <TextBlock Text="{res:Text CreateServer_CustomGeneratorHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <TextBlock Text="{res:Text CreateServer_CustomGeneratorInvalid}"
                     Foreground="{DynamicResource ErrorTextBrush}"
                     TextWrapping="Wrap" Margin="0,4,0,0"
                     Visibility="{Binding CustomGeneratorInvalid, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <CheckBox IsChecked="{Binding EulaAccepted}" IsEnabled="{Binding IsIdle}" Margin="0,18,0,0">
          <TextBlock TextWrapping="Wrap">
            <Run Text="{res:Text CreateServer_EulaPrefix}" />
            <Hyperlink Command="{Binding OpenEulaCommand}"><Run Text="{res:Text CreateServer_EulaLink}" /></Hyperlink>
          </TextBlock>
        </CheckBox>

        <StackPanel Margin="0,18,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <controls:PixelScene Scene="downloading" Width="32" Height="32" Margin="0,0,8,0" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
          </StackPanel>
          <ProgressBar
                       Value="{Binding ProgressPercent, Mode=OneWay}"
                       IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
        </StackPanel>

        <Border Margin="0,14,0,0">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
