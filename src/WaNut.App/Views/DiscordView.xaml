<UserControl x:Class="WaNut.App.Views.DiscordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources">
  <!-- DataContext: DiscordViewModel -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style x:Key="Item" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style x:Key="Step" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="3,3,18,18">
      <TextBlock Text="{res:Text Discord_BridgeIntro}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding LocationText}" Style="{StaticResource Hint}" Margin="0,3,0,12" />

      <!-- Banners: plain wording, no peanut (decision 16). -->
      <Border Margin="0,0,0,12">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel AutomationProperties.LiveSetting="Assertive">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
          <TextBox Text="{Binding ErrorDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                   FontSize="{StaticResource FontSmall}" Margin="0,6,0,0" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                   AutomationProperties.Name="{res:Text Discord_ErrorDetail}">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ErrorDetail}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>
        </StackPanel>
      </Border>

      <Border Margin="0,0,0,12">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource NoticeBanner}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding OkText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding OkText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </Border>

      <ItemsControl ItemsSource="{Binding Warnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,12">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,12" Visibility="{Binding ShowRestartNote, Converter={StaticResource Visible}}">
        <TextBlock Text="{res:Text Discord_RestartNote}" TextWrapping="Wrap" />
      </Border>

      <Border Style="{StaticResource NoticeBanner}" Margin="0,0,0,12" Visibility="{Binding ShowFilesOnVpsNote, Converter={StaticResource Visible}}">
        <TextBlock Text="{res:Text Discord_FilesOnVpsNote}" TextWrapping="Wrap" />
      </Border>

      <!-- Status board -->
      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="{StaticResource ControlRadius}" Padding="12" Margin="0,0,0,18">
        <StackPanel>
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="{res:Text Discord_Refresh}" Command="{Binding RefreshCommand}" />
            <TextBlock Text="{res:Text Discord_StatusTitle}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
          </DockPanel>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{res:Text Discord_StatusBridge}" Style="{StaticResource Hint}" Margin="0,0,12,3" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StateText}" FontWeight="SemiBold" Margin="0,0,0,3" />
            <TextBlock Grid.Row="1" Text="{res:Text Discord_StatusRcon}" Style="{StaticResource Hint}" Margin="0,0,12,3" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RconText}" Margin="0,0,0,3" />
            <TextBlock Grid.Row="2" Text="{res:Text Discord_StatusDiscord}" Style="{StaticResource Hint}" Margin="0,0,12,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiscordText}" />
          </Grid>
          <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,6">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Text="{res:Text Discord_ActivityTitle}" Style="{StaticResource Hint}" Margin="0,6,0,3" />
          <Border Background="{DynamicResource ConsoleBrush}" CornerRadius="{StaticResource ControlRadius}" Height="140">
            <ListBox ItemsSource="{Binding LogLines}" ItemContainerStyle="{StaticResource ConsoleLine}"
                     Foreground="{DynamicResource ConsoleTextBrush}" Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="{StaticResource FontSmall}" Focusable="False" Padding="6,6"
                     AutomationProperties.Name="{res:Text Discord_ActivityTitle}">
              <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                  <Setter Property="Foreground" Value="{DynamicResource ConsoleScrollThumbBrush}" />
                </Style>
              </ListBox.Resources>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,6,0" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{res:Text Discord_Stop}" Command="{Binding StopCommand}" Margin="0,0,6,0" />
            <Button Content="{res:Text Discord_Remove}" Command="{Binding RemoveCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Always visible -->
      <StackPanel Style="{StaticResource Item}">
        <TextBlock Text="{res:Text Discord_ModeLabel}" Style="{StaticResource Label}" />
        <ComboBox ItemsSource="{Binding PresentationOptions}" DisplayMemberPath="Name" SelectedItem="{Binding Presentation}"
                  HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="{res:Text Discord_ModeLabel}" />
        <TextBlock Text="{res:Text Discord_ModeHint}" Style="{StaticResource Hint}" />
      </StackPanel>

      <StackPanel Style="{StaticResource Item}">
        <TextBlock Text="{res:Text Discord_TokenLabel}" Style="{StaticResource Label}" />
        <PasswordBox x:Name="TokenBox" PasswordChanged="OnSecretChanged" AutomationProperties.Name="{res:Text Discord_TokenLabel}" />
        <TextBlock Text="{Binding TokenHint}" Style="{StaticResource Hint}" />
        <TextBlock Text="{res:Text Discord_TokenHint}" Style="{StaticResource Hint}" />
      </StackPanel>

      <StackPanel Style="{StaticResource Item}">
        <TextBlock Text="{res:Text Discord_ChannelLabel}" Style="{StaticResource Label}" />
        <TextBox Text="{Binding ChannelId, UpdateSourceTrigger=PropertyChanged}" MaxLength="25" AutomationProperties.Name="{res:Text Discord_ChannelLabel}" />
        <TextBlock Text="{res:Text Discord_ChannelHint}" Style="{StaticResource Hint}" />
      </StackPanel>

      <StackPanel Style="{StaticResource Item}" Visibility="{Binding UsesWebhook, Converter={StaticResource Visible}}">
        <TextBlock Text="{res:Text Discord_WebhookLabel}" Style="{StaticResource Label}" />
        <PasswordBox x:Name="WebhookBox" PasswordChanged="OnSecretChanged" AutomationProperties.Name="{res:Text Discord_WebhookLabel}" />
        <TextBlock Text="{Binding WebhookHint}" Style="{StaticResource Hint}" />
        <TextBlock Text="{res:Text Discord_WebhookHint}" Style="{StaticResource Hint}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="{res:Text Discord_TestConnection}" Command="{Binding TestCommand}" Margin="0,0,6,0" />
        <Button Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" />
      </StackPanel>
      <TextBlock Text="{Binding StepText}" Style="{StaticResource Hint}" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite" />

      <!-- More settings -->
      <Expander Header="{res:Text Settings_MoreSettings}" Margin="-3,0,0,12">
        <StackPanel Margin="3,6,0,0">
          <TextBlock Text="{res:Text Discord_FiltersLabel}" Style="{StaticResource Label}" />
          <CheckBox IsChecked="{Binding Chat}" Content="{res:Text Discord_FilterChat}" Margin="0,0,0,3" />
          <CheckBox IsChecked="{Binding JoinLeave}" Content="{res:Text Discord_FilterJoinLeave}" Margin="0,0,0,3" />
          <CheckBox IsChecked="{Binding DeathsAndAdvancements}" Content="{res:Text Discord_FilterDeaths}" Margin="0,0,0,3" />
          <CheckBox IsChecked="{Binding ServerState}" Content="{res:Text Discord_FilterServerState}" Margin="0,0,0,3" />
          <CheckBox IsChecked="{Binding OnlineCountStatus}" Content="{res:Text Discord_FilterOnlineCount}" Margin="0,0,0,3" />
          <CheckBox IsChecked="{Binding StatusBoard}" Content="{res:Text Discord_FilterStatusBoard}" Margin="0,0,0,3" />
          <CheckBox IsChecked="{Binding ListCommand}" Content="{res:Text Discord_FilterListCommand}" Margin="0,0,0,12" />

          <CheckBox IsChecked="{Binding IgnorePrefixes}" Content="{res:Text Discord_FilterPrefixes}" />
          <StackPanel Visibility="{Binding ShowPrefixes, Converter={StaticResource Visible}}" Margin="24,3,0,12">
            <TextBox Text="{Binding IgnoredPrefixes, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="{res:Text Discord_FilterPrefixes}" />
            <TextBlock Text="{res:Text Discord_PrefixesHint}" Style="{StaticResource Hint}" />
          </StackPanel>

          <CheckBox IsChecked="{Binding RemoteConsole}" Content="{res:Text Discord_RemoteConsole}" Margin="0,0,0,3" />
          <TextBlock Text="{res:Text Discord_RemoteConsoleHint}" Style="{StaticResource Hint}" Margin="24,0,0,6" />
          <StackPanel Visibility="{Binding ShowAdminRole, Converter={StaticResource Visible}}" Margin="24,0,0,12">
            <TextBlock Text="{res:Text Discord_RoleLabel}" Style="{StaticResource Label}" />
            <TextBox Text="{Binding AdminRoleId, UpdateSourceTrigger=PropertyChanged}" MaxLength="25" AutomationProperties.Name="{res:Text Discord_RoleLabel}" />
            <TextBlock Text="{res:Text Discord_RoleHint}" Style="{StaticResource Hint}" />
          </StackPanel>

          <TextBlock Text="{res:Text Discord_LanguageLabel}" Style="{StaticResource Label}" Margin="0,6,0,6" />
          <ComboBox ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedItem="{Binding Language}"
                    HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="{res:Text Discord_LanguageLabel}" />
          <TextBlock Text="{res:Text Discord_LanguageHint}" Style="{StaticResource Hint}" Margin="0,3,0,12" />

          <StackPanel Visibility="{Binding ShowsStartOnBoot, Converter={StaticResource Visible}}">
            <CheckBox IsChecked="{Binding StartOnBoot}" Content="{res:Text Discord_StartOnBoot}" />
            <TextBlock Text="{res:Text Discord_StartOnBootHint}" Style="{StaticResource Hint}" Margin="24,3,0,12" />
          </StackPanel>
          <TextBlock Text="{res:Text Discord_VpsBootNote}" Style="{StaticResource Hint}" Margin="0,0,0,12"
                     Visibility="{Binding RunsOnVps, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Expander>

      <!-- Help: how to make the bot -->
      <Expander Header="{res:Text Discord_HelpTitle}" Margin="-3,0,0,0">
        <StackPanel Margin="3,6,0,0">
          <TextBlock Text="{res:Text Discord_Help1}" Style="{StaticResource Step}" />
          <TextBlock Text="{res:Text Discord_Help2}" Style="{StaticResource Step}" />
          <TextBlock Text="{res:Text Discord_Help3}" Style="{StaticResource Step}" />
          <TextBlock Text="{res:Text Discord_Help4}" Style="{StaticResource Step}" />
          <TextBlock Text="{res:Text Discord_Help5}" Style="{StaticResource Step}" />
          <TextBlock Text="{res:Text Discord_Help6}" Style="{StaticResource Step}" />
          <Button Content="{res:Text Discord_OpenPortal}" Command="{Binding OpenDeveloperPortalCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
