<UserControl x:Class="WaNut.App.Views.WorldPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources">
  <!-- DataContext: WorldPickerViewModel -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>
  <StackPanel>
    <ListBox ItemsSource="{Binding Worlds}"
             SelectedItem="{Binding Selected}"
             MaxHeight="220"
             AutomationProperties.Name="{res:Text World_ListLabel}"
             Background="{DynamicResource CardBrush}"
             BorderThickness="1"
             Padding="4"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
          <Setter Property="AutomationProperties.HelpText" Value="{Binding Subtitle}" />
          <Setter Property="Padding" Value="10,6" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsScanning, Converter={StaticResource Visible}}">
      <Image Style="{StaticResource BusyPeanut}" Width="18" Height="18" Margin="0,0,6,0" />
      <TextBlock Text="{res:Text World_Scanning}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Text="{res:Text World_NoneFound}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
               Visibility="{Binding ShowNoWorlds, Converter={StaticResource Visible}}" />

    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="{res:Text World_ChooseFolder}" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0" />
      <Button Content="{res:Text World_ChooseZip}" Command="{Binding ChooseZipCommand}" />
    </StackPanel>

    <Border Margin="0,10,0,0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
    </Border>

    <TextBlock Text="{res:Text World_OldWorldHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
               Visibility="{Binding ShowOldWorldHint, Converter={StaticResource Visible}}" />

    <!-- A world played with mods: plain red wording and a second, deliberate tick. -->
    <Border Style="{StaticResource ErrorBanner}" Margin="0,10,0,0"
            Visibility="{Binding ShowModdedWarning, Converter={StaticResource Visible}}">
      <StackPanel>
        <TextBlock Text="{Binding ModdedWarningText}" TextWrapping="Wrap" />
        <CheckBox IsChecked="{Binding ModdedAccepted}" Margin="0,10,0,0">
          <TextBlock Text="{res:Text World_ModdedAccept}" TextWrapping="Wrap" />
        </CheckBox>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
