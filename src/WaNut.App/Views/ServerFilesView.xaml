<UserControl x:Class="WaNut.App.Views.ServerFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources"
             xmlns:vm="clr-namespace:WaNut.App.ViewModels">
  <!-- DataContext: ServerFilesViewModel -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The editor scrolls both ways: the text box style of the other screens hides its scroll bars. -->
    <Style x:Key="EditorBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="AcceptsTab" Value="True" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource ControlRadius}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}" />
  </UserControl.InputBindings>

  <Grid Margin="3,3,18,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <!-- Why the files can only be read right now -->
      <Border Style="{StaticResource NoticeBanner}" Margin="0,0,0,12"
              Visibility="{Binding ShowReadOnlyNote, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding ReadOnlyNote}" TextWrapping="Wrap" />
      </Border>

      <!-- Errors: plain wording, no peanut (decision 16). -->
      <Border Margin="0,0,0,12">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="240" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="3*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <!-- Left: the folder tree and how much space each kind of file takes -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Content="{res:Text Files_Refresh}" Command="{Binding RefreshCommand}" />
          <TextBlock Text="{res:Text Files_TreeTitle}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0" />
        </DockPanel>

        <Grid Grid.Row="1">
          <ListBox x:Name="Tree" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   Visibility="{Binding ShowTree, Converter={StaticResource Visible}}"
                   AutomationProperties.Name="{res:Text Files_TreeTitle}"
                   MouseDoubleClick="OnTreeDoubleClick">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                <DockPanel Margin="{Binding Indent}" LastChildFill="True">
                  <Button DockPanel.Dock="Left" Width="18" Padding="0" Content="{Binding Glyph}"
                          Command="{Binding DataContext.ToggleCommand, ElementName=Tree}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding ToggleName}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource MutedText}"
                             FontSize="{StaticResource FontSmall}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding CategoryText}" Style="{StaticResource MutedText}"
                             FontSize="{StaticResource FontSmall}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{res:Text Files_Loading}" Style="{StaticResource Hint}" Margin="6,6,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource Visible}}"
                     AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{res:Text Files_Empty}" Style="{StaticResource Hint}" Margin="6,6,0,0"
                     Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}" />
        </Grid>

        <!-- Space used -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <DockPanel Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontWeight="SemiBold" />
            <TextBlock Text="{res:Text Files_SpaceTitle}" Style="{StaticResource Label}" Margin="0" />
          </DockPanel>
          <TextBlock Text="{res:Text Files_SpaceMeasuring}" Style="{StaticResource Hint}"
                     Visibility="{Binding IsMeasuring, Converter={StaticResource Visible}}" />
          <ItemsControl ItemsSource="{Binding Usage}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:UsageRowViewModel}">
                <StackPanel Margin="0,0,0,6">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource MutedText}"
                               FontSize="{StaticResource FontSmall}" />
                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSmall}" />
                  </DockPanel>
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Height="6" Margin="0,3,0,0"
                               AutomationProperties.Name="{Binding AccessibleName}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <!-- Right: the editor -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{res:Text Files_EditorHint}" Style="{StaticResource Hint}"
                   Visibility="{Binding ShowPlaceholder, Converter={StaticResource Visible}}" />
        <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="{Binding InfoText}" TextWrapping="Wrap"
                   Visibility="{Binding ShowInfo, Converter={StaticResource Visible}}" />

        <DockPanel Grid.Row="0" Margin="0,0,0,6" Visibility="{Binding ShowEditor, Converter={StaticResource Visible}}">
          <TextBlock DockPanel.Dock="Right" Text="{res:Text Files_Unsaved}" Style="{StaticResource MutedText}"
                     FontSize="{StaticResource FontSmall}" VerticalAlignment="Center" Margin="12,0,0,0"
                     Visibility="{Binding IsDirty, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Label}" Margin="0" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <TextBox Grid.Row="1" Style="{StaticResource EditorBox}" Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding EditorReadOnly}" Visibility="{Binding ShowEditor, Converter={StaticResource Visible}}"
                 AutomationProperties.Name="{Binding EditorTitle}" />

        <StackPanel Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding ShowEditor, Converter={StaticResource Visible}}">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource PrimaryButton}" Content="{res:Text Files_Save}" Command="{Binding SaveCommand}" MinWidth="110" />
            <Button Content="{res:Text Files_Revert}" Command="{Binding RevertCommand}" Margin="6,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" Margin="0,6,0,0"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
