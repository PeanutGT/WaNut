<Window x:Class="WaNut.App.Views.ModDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WaNut.App.Resources"
        Title="{Binding Title}"
        Icon="pack://application:,,,/Assets/wanut.ico"
        Style="{StaticResource AppWindow}"
        Width="640" Height="620" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>

  <!-- DataContext: ModDetailsViewModel -->
  <DockPanel Margin="24">
    <!-- Header: icon, name, Modrinth link -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="10" Margin="0,0,12,0"
              Background="{DynamicResource SidebarBrush}" ClipToBounds="True">
        <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Focusable="False" />
      </Border>
      <Button DockPanel.Dock="Right" Content="{res:Text ModDetails_OpenPage}" Command="{Binding OpenPageCommand}"
              Padding="10,3" VerticalAlignment="Center" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Result.DetailText}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DockPanel>

    <Button DockPanel.Dock="Bottom" Content="{res:Text ModDetails_Close}" Command="{Binding CloseCommand}" IsCancel="True"
            HorizontalAlignment="Right" MinWidth="88" Margin="0,14,0,0" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="{res:Text ModDetails_Loading}" Style="{StaticResource MutedText}"
                   Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" />

        <Border Margin="0,0,0,12">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Border>

        <!-- Versions first: picking one is why the window is open. -->
        <TextBlock Text="{res:Text ModDetails_Versions}" Style="{StaticResource SectionCaption}" Margin="0,0,0,6" />
        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding InstallNote}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding InstallNote}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{res:Text ModDetails_NoVersions}" Style="{StaticResource MutedText}"
                   Visibility="{Binding ShowNoVersions, Converter={StaticResource Visible}}" />
        <ListBox ItemsSource="{Binding Versions}" MaxHeight="220" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                 AutomationProperties.Name="{res:Text ModDetails_Versions}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False" />
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{res:Text ModDetails_Install}" Padding="10,2" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding InstallLabel}"
                          Visibility="{Binding DataContext.CanInstall, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"
                          Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                  <Border DockPanel.Dock="Left" CornerRadius="8" Padding="7,1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource OnlineBadgeBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsRelease}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding TypeText}" FontSize="11" />
                  </Border>
                  <StackPanel>
                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource MutedText}" FontSize="12" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Pictures -->
        <StackPanel Margin="0,18,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Gallery.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{res:Text ModDetails_Gallery}" Style="{StaticResource SectionCaption}" Margin="0,0,0,6" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Gallery}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="6" ClipToBounds="True" Margin="0,0,8,6" Background="{DynamicResource SidebarBrush}">
                    <Image Source="{Binding}" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- About -->
        <TextBlock Text="{res:Text ModDetails_About}" Style="{StaticResource SectionCaption}" Margin="0,18,0,6" />
        <TextBox Text="{Binding About, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                 Background="Transparent" Padding="0" AutomationProperties.Name="{res:Text ModDetails_About}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
