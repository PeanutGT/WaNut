<Window x:Class="WaNut.App.Views.ImportWorldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WaNut.App.Resources"
        xmlns:views="clr-namespace:WaNut.App.Views"
        Title="{res:Text Import_Title}"
        Icon="pack://application:,,,/Assets/wanut.ico"
        Style="{StaticResource AppWindow}"
        Width="520" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{res:Text Common_Cancel}" Command="{Binding CancelCommand}" MinWidth="80" Margin="0,0,8,0" />
      <Button Content="{res:Text Import_Confirm}" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}"
              MinWidth="80" IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel>
        <TextBlock Text="{res:Text Import_Title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ServerText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        <TextBlock Text="{res:Text Import_Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />

        <TextBlock Text="{res:Text World_PickLabel}" Style="{StaticResource FieldLabel}" />
        <views:WorldPicker DataContext="{Binding Picker}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" />

        <!-- The server's version is older than the world's: a plain warning and a second, deliberate tick. -->
        <Border Style="{StaticResource WarningBanner}" Margin="0,10,0,0"
                Visibility="{Binding ShowNewerWorldWarning, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding NewerWorldWarningText}" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding NewerWorldAccepted}" IsEnabled="{Binding IsIdle}" Margin="0,10,0,0">
              <TextBlock Text="{res:Text World_NewerAccept}" TextWrapping="Wrap" />
            </CheckBox>
          </StackPanel>
        </Border>

        <TextBlock Text="{res:Text CreateServer_OwnerLabel}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}"
                 Tag="{res:Text CreateServer_OwnerPlaceholder}"
                 AutomationProperties.Name="{res:Text CreateServer_OwnerLabel}"
                 MaxLength="16" InputMethod.IsInputMethodEnabled="False"
                 IsEnabled="{Binding IsIdle}" />
        <TextBlock Text="{res:Text Players_InvalidName}"
                   Foreground="{DynamicResource ErrorTextBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding OwnerNameInvalid, Converter={StaticResource BoolToVisibility}}" />
        <CheckBox IsChecked="{Binding BringInventory}" IsEnabled="{Binding CanBringInventory}" Margin="0,12,0,0">
          <TextBlock Text="{res:Text World_BringInventory}" TextWrapping="Wrap" />
        </CheckBox>

        <StackPanel Margin="0,18,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Image Style="{StaticResource BusyPeanut}" Width="20" Height="20" Margin="0,0,8,0" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" AutomationProperties.Name="{Binding StatusText}" />
        </StackPanel>

        <Border Margin="0,14,0,0">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
