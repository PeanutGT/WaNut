<Window x:Class="WaNut.App.Views.ResetWorldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WaNut.App.Resources"
        Title="{res:Text Reset_Title}"
        Icon="pack://application:,,,/Assets/wanut.ico"
        Style="{StaticResource AppWindow}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <!-- Deletes the world (after a backup), so plain wording and Cancel as the default button. -->
  <StackPanel Margin="24">
    <TextBlock Text="{res:Text Reset_Title}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,0" />

    <TextBlock Text="{res:Text Reset_SeedLabel}" FontWeight="SemiBold" Margin="0,16,0,6" />
    <TextBox x:Name="SeedBox" MaxLength="64" AutomationProperties.Name="{res:Text Reset_SeedLabel}" />
    <TextBlock Text="{res:Text Reset_SeedHint}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

    <Border Style="{StaticResource NoticeBanner}" Margin="0,16,0,0">
      <TextBlock Text="{res:Text Reset_BackupNote}" TextWrapping="Wrap" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{res:Text Reset_Confirm}" MinWidth="80" Margin="0,0,8,0" Click="OnConfirm" />
      <Button x:Name="CancelButton" Content="{res:Text Common_Cancel}" MinWidth="80" IsDefault="True" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
