<Window x:Class="WaNut.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WaNut.App.Resources"
        Title="{res:Text App_Title}"
        Width="1000" Height="640"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Server list -->
    <Border Grid.Column="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="{res:Text App_Title}"
                   FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,16" />

        <Button DockPanel.Dock="Bottom"
                Content="{res:Text Main_CreateServer}"
                Command="{Binding CreateServerCommand}"
                Style="{StaticResource PrimaryButton}"
                Margin="0,16,0,0" />

        <Grid>
          <ListBox x:Name="ServerList"
                   ItemsSource="{Binding Servers}"
                   Background="Transparent"
                   BorderThickness="0" />
          <TextBlock Text="{res:Text Main_NoServers}"
                     Foreground="{StaticResource MutedTextBrush}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     TextAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Servers.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </DockPanel>
    </Border>

    <!-- Server details -->
    <TextBlock Grid.Column="1"
               Text="{res:Text Main_SelectServer}"
               Foreground="{StaticResource MutedTextBrush}"
               FontSize="15"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
  </Grid>
</Window>
