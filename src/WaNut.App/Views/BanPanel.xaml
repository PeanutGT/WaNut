<UserControl x:Class="WaNut.App.Views.BanPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources"
             xmlns:controls="clr-namespace:WaNut.App.Controls">
  <!-- Keeps a player out until they are unbanned, so Cancel is the default button. Shown with InlinePanel. -->
  <StackPanel>
    <TextBlock Text="{res:Text Ban_Title}" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
    <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontSize="{StaticResource FontSubheading}" Margin="0,12,0,0" />

    <TextBlock Text="{res:Text Ban_ReasonLabel}" FontWeight="SemiBold" Margin="0,18,0,6" />
    <TextBox x:Name="ReasonBox" MaxLength="100" AutomationProperties.Name="{res:Text Ban_ReasonLabel}" />
    <TextBlock Text="{res:Text Ban_ReasonHint}" Style="{StaticResource MutedText}" FontSize="{StaticResource FontSmall}" TextWrapping="Wrap" Margin="0,3,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{res:Text Ban_Confirm}" MinWidth="80" Margin="0,0,6,0" controls:InlinePanel.Answer="True" />
      <Button Content="{res:Text Common_Cancel}" MinWidth="80" controls:InlinePanel.Answer="False"
              controls:InlinePanel.IsDefault="True" controls:InlinePanel.TakesFocus="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
