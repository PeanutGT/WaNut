<UserControl x:Class="WaNut.App.Views.PacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources">
  <!-- DataContext: PacksViewModel -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <!-- A plain list: no selection of its own, but each row is a list item screen readers can enter. -->
    <Style x:Key="PlainList" TargetType="ListBox">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ItemsPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A long plain list (a modpack can bring hundreds of mods): it scrolls on its own, so only the visible rows are built. -->
    <Style x:Key="ScrollingList" TargetType="ListBox" BasedOn="{StaticResource PlainList}">
      <Setter Property="MaxHeight" Value="420" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ScrollViewer Focusable="False" CanContentScroll="True"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="4,4,16,16">
      <Border Style="{StaticResource NoticeBanner}" Margin="0,0,0,14"
              Visibility="{Binding ShowStopToChange, Converter={StaticResource Visible}}">
        <TextBlock Text="{res:Text Packs_StopToChange}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Margin="0,0,0,14" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Image Style="{StaticResource BusyPeanut}" Width="22" Height="22" Margin="0,0,8,0" />
          <TextBlock Text="{Binding WorkText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding WorkFraction, Mode=OneWay}" Height="6"
                     AutomationProperties.Name="{Binding WorkText}" />
      </StackPanel>

      <TextBlock Text="{Binding DoneText}" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding DoneText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <Border Margin="0,0,0,14">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
      </Border>

      <!-- Server resource pack -->
      <TextBlock Text="{res:Text Packs_ResourcePack}" Style="{StaticResource SectionCaption}" Margin="0,0,0,6" />
      <TextBlock Text="{res:Text Packs_ResourcePackHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
      <TextBlock Text="{res:Text Packs_NoResourcePack}" FontWeight="SemiBold">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasResourcePack}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <StackPanel Visibility="{Binding HasResourcePack, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{res:Text Packs_ClearResourcePack}" Command="{Binding ClearResourcePackCommand}" Padding="10,3" />
          <TextBlock Text="{Binding ResourcePackName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
        <CheckBox Content="{res:Text Packs_Require}" IsChecked="{Binding RequireResourcePack}" IsEnabled="{Binding CanChange}" Margin="0,8,0,0" />
      </StackPanel>

      <!-- Data packs -->
      <DockPanel Margin="0,28,0,6">
        <Button DockPanel.Dock="Right" Content="{res:Text Mods_OpenFolder}" Command="{Binding OpenFolderCommand}" Padding="10,3" />
        <TextBlock Text="{Binding DatapacksHeader}" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock Text="{res:Text Packs_DataPacksHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
      <ListBox Style="{StaticResource ScrollingList}" ItemsSource="{Binding Datapacks}" AutomationProperties.Name="{Binding DatapacksHeader}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{res:Text Mods_Remove}" Padding="10,3" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding RemoveLabel}"
                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{res:Text Packs_EmptyDataPacks}" FontWeight="SemiBold" Margin="0,4,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Datapacks.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!-- Find on Modrinth -->
      <TextBlock Text="{Binding FindHeader}" Style="{StaticResource SectionCaption}" Margin="0,28,0,8" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <RadioButton Content="{res:Text Packs_KindDataPacks}" IsChecked="{Binding IsDataPacks}" GroupName="PackKind" Margin="0,0,16,0" />
        <RadioButton Content="{res:Text Packs_KindResourcePacks}" IsChecked="{Binding IsResourcePacks}" GroupName="PackKind" />
      </StackPanel>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{res:Text Mods_SearchBox}">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <Button Grid.Column="1" Content="{res:Text Mods_Search}" Command="{Binding SearchCommand}" Margin="8,0,0,0" MinWidth="80" />
      </Grid>
      <DockPanel Margin="0,4,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
          <TextBlock Text="{res:Text Mods_Sort}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox ItemsSource="{Binding SortOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                    SelectedValue="{Binding Sort}" MinWidth="140" AutomationProperties.Name="{res:Text Mods_Sort}" />
        </StackPanel>
        <TextBlock Text="{Binding FilterText}" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center" />
      </DockPanel>

      <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Results}" AutomationProperties.Name="{Binding FindHeader}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                  <Button Content="{res:Text Mods_Page}" Padding="10,3" Margin="0,0,6,0"
                          AutomationProperties.Name="{Binding PageLabel}"
                          Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                          CommandParameter="{Binding}" />
                  <Grid MinWidth="80">
                    <Button Content="{Binding DataContext.UseText, RelativeSource={RelativeSource AncestorType=ListBox}}" Padding="10,3"
                            AutomationProperties.Name="{Binding InstallLabel}"
                            Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding DataContext.InUseText, RelativeSource={RelativeSource AncestorType=ListBox}}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding IsInstalled, Converter={StaticResource Visible}}" />
                  </Grid>
                </StackPanel>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="8" Margin="0,2,10,0" VerticalAlignment="Top"
                        Background="{DynamicResource SidebarBrush}" ClipToBounds="True">
                  <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Focusable="False" />
                </Border>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="{res:Text Mods_Searching}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                 Visibility="{Binding IsSearching, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{res:Text Mods_NoResults}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                 Visibility="{Binding ShowNoResults, Converter={StaticResource Visible}}" />
      <Button Content="{res:Text Mods_LoadMore}" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
              Visibility="{Binding CanLoadMore, Converter={StaticResource Visible}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
