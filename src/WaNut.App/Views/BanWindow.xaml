<Window x:Class="WaNut.App.Views.BanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WaNut.App.Resources"
        Title="{res:Text Ban_Title}"
        Icon="pack://application:,,,/Assets/wanut.ico"
        Style="{StaticResource AppWindow}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <!-- Keeps a player out until they are unbanned, so Cancel is the default button. -->
  <StackPanel Margin="24">
    <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontSize="14" />

    <TextBlock Text="{res:Text Ban_ReasonLabel}" FontWeight="SemiBold" Margin="0,16,0,6" />
    <TextBox x:Name="ReasonBox" MaxLength="100" AutomationProperties.Name="{res:Text Ban_ReasonLabel}" />
    <TextBlock Text="{res:Text Ban_ReasonHint}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{res:Text Ban_Confirm}" MinWidth="80" Margin="0,0,8,0" Click="OnConfirm" />
      <Button x:Name="CancelButton" Content="{res:Text Common_Cancel}" MinWidth="80" IsDefault="True" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
