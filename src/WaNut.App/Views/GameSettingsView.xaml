<UserControl x:Class="WaNut.App.Views.GameSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources"
             xmlns:views="clr-namespace:WaNut.App.Views">
  <!-- DataContext: GameSettingsViewModel. Every setting is a SettingEntryViewModel; its control comes from the setting's type. -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style x:Key="CheckHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
      <Setter Property="Margin" Value="24,3,0,0" />
    </Style>
    <!-- When a control gets focus, the whole item scrolls into view, so its heading is never left above the top.
         A setting that does not match the search is collapsed. -->
    <Style x:Key="Item" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,18" />
      <EventSetter Event="RequestBringIntoView" Handler="Item_RequestBringIntoView" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsVisible}" Value="False">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ToggleTemplate">
      <StackPanel Style="{StaticResource Item}">
        <CheckBox Content="{Binding Title}" IsChecked="{Binding Item.BoolValue}" IsEnabled="{Binding IsEnabled}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource CheckHint}"
                   Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DropdownTemplate">
      <StackPanel Style="{StaticResource Item}">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" />
        <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding Item.RawValue}" IsEnabled="{Binding IsEnabled}"
                  AutomationProperties.Name="{Binding Title}" Width="220" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}"
                   Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SliderTemplate">
      <StackPanel Style="{StaticResource Item}">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" />
        <DockPanel IsEnabled="{Binding IsEnabled}">
          <TextBlock DockPanel.Dock="Right" Width="80" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="{Binding Item.NumericValue, StringFormat={res:Text Game_Chunks}}" />
          <Slider Minimum="{Binding Min}" Maximum="{Binding Max}"
                  IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="4"
                  Value="{Binding Item.NumericValue, Delay=400}"
                  AutomationProperties.Name="{Binding Title}" />
        </DockPanel>
        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}"
                   Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NumberTemplate">
      <StackPanel Style="{StaticResource Item}">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" />
        <TextBox Text="{Binding NumberText}" IsEnabled="{Binding IsEnabled}"
                 AutomationProperties.Name="{Binding Title}" Width="100" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}"
                   Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TextTemplate">
      <StackPanel Style="{StaticResource Item}">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" />
        <TextBox Text="{Binding Item.RawValue}" IsEnabled="{Binding IsEnabled}" IsReadOnly="{Binding HasNote}" MaxLength="200"
                 AutomationProperties.Name="{Binding Title}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}"
                   Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}"
                   Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
      </StackPanel>
    </DataTemplate>

    <views:SettingTemplateSelector x:Key="SettingTemplates"
                                   Toggle="{StaticResource ToggleTemplate}" Dropdown="{StaticResource DropdownTemplate}"
                                   Slider="{StaticResource SliderTemplate}" Number="{StaticResource NumberTemplate}"
                                   Text="{StaticResource TextTemplate}" />

    <!-- One line of the full property list: the file key and its value, as text. -->
    <DataTemplate x:Key="PropertyLineTemplate">
      <Grid Margin="0,0,0,6">
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsVisible}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Key}" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Title}" />
        <TextBox Grid.Column="1" Text="{Binding Item.RawValue}" IsEnabled="{Binding IsEnabled}" FontFamily="Consolas"
                 AutomationProperties.Name="{Binding Key}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="3,3,18,18">
      <Border Style="{StaticResource NoticeBanner}" Margin="0,0,0,18"
              Visibility="{Binding ShowStopHint, Converter={StaticResource Visible}}">
        <TextBlock Text="{res:Text Game_StopToChange}" TextWrapping="Wrap" />
      </Border>

      <Border Style="{StaticResource NoticeBanner}" Margin="0,0,0,18"
              Visibility="{Binding ShowVpsSettingsNote, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding VpsSettingsNote}" TextWrapping="Wrap" />
      </Border>

      <!-- Matches the English and Traditional Chinese name, the description and the file key. -->
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="{res:Text Settings_SearchPlaceholder}"
               AutomationProperties.Name="{res:Text Settings_SearchPlaceholder}" Margin="0,0,0,18" />

      <TextBlock Text="{res:Text Settings_SearchNoResults}" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"
                 Visibility="{Binding ShowNoResults, Converter={StaticResource Visible}}" />

      <!-- Core settings: always open. -->
      <ItemsControl ItemsSource="{Binding Core}" ItemTemplateSelector="{StaticResource SettingTemplates}" IsTabStop="False" />

      <Expander Header="{Binding WorldRules.Title}" IsExpanded="{Binding WorldRules.IsExpanded, Mode=TwoWay}" Margin="-3,0,0,12"
                Visibility="{Binding WorldRules.IsShown, Converter={StaticResource Visible}}">
        <ItemsControl ItemsSource="{Binding WorldRules.Entries}" ItemTemplateSelector="{StaticResource SettingTemplates}"
                      Margin="3,6,0,0" IsTabStop="False" />
      </Expander>

      <Expander Header="{Binding NetworkPerf.Title}" IsExpanded="{Binding NetworkPerf.IsExpanded, Mode=TwoWay}" Margin="-3,0,0,12"
                Visibility="{Binding NetworkPerf.IsShown, Converter={StaticResource Visible}}">
        <ItemsControl ItemsSource="{Binding NetworkPerf.Entries}" ItemTemplateSelector="{StaticResource SettingTemplates}"
                      Margin="3,6,0,0" IsTabStop="False" />
      </Expander>

      <!-- Advanced mode only: every line of server.properties, plain wording, no peanut (decision 16). -->
      <StackPanel Visibility="{Binding App.AdvancedMode, Converter={StaticResource Visible}}">
        <Expander Header="{Binding FullList.Title}" IsExpanded="{Binding FullList.IsExpanded, Mode=TwoWay}" Margin="-3,0,0,0"
                  Visibility="{Binding FullList.IsShown, Converter={StaticResource Visible}}">
          <StackPanel Margin="3,6,0,0">
            <TextBlock Text="{res:Text Settings_FullPropertiesHint}" Style="{StaticResource Hint}" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding FullList.Entries}" ItemTemplate="{StaticResource PropertyLineTemplate}" IsTabStop="False" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
