<UserControl x:Class="WaNut.App.Views.DuplicateServerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources"
             xmlns:controls="clr-namespace:WaNut.App.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <!-- DataContext: DuplicateServerViewModel. Shown with InlinePanel. -->
  <StackPanel>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{res:Text Duplicate_Title}" FontSize="{StaticResource FontTitle}" FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Text="{res:Text Duplicate_Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,18" />

    <TextBlock Text="{res:Text Duplicate_NameLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" MaxLength="64"
             controls:InlinePanel.TakesFocus="True" AutomationProperties.Name="{res:Text Duplicate_NameLabel}" />

    <StackPanel Margin="0,18,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{res:Text Duplicate_Working}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite" />
      <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" AutomationProperties.Name="{res:Text Duplicate_Working}" />
    </StackPanel>

    <Border Margin="0,12,0,0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{res:Text Duplicate_Confirm}" Command="{Binding DuplicateCommand}" Style="{StaticResource PrimaryButton}"
              MinWidth="80" Margin="0,0,6,0" controls:InlinePanel.IsDefault="True" />
      <Button Content="{res:Text Common_Cancel}" Command="{Binding CancelCommand}" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</UserControl>
