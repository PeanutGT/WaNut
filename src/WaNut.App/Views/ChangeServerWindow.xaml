<Window x:Class="WaNut.App.Views.ChangeServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WaNut.App.Resources"
        Title="{res:Text Change_Title}"
        Icon="pack://application:,,,/Assets/wanut.ico"
        Style="{StaticResource AppWindow}"
        Width="520" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{res:Text Common_Cancel}" Command="{Binding CancelCommand}" MinWidth="80" Margin="0,0,8,0" />
      <Button Content="{res:Text Change_Confirm}" Command="{Binding ChangeCommand}" Style="{StaticResource PrimaryButton}"
              MinWidth="80" IsDefault="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel>
        <TextBlock Text="{res:Text Change_Title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
          <Run Text="{res:Text Change_Current}" />
          <Run Text="{Binding CurrentText, Mode=OneTime}" FontWeight="SemiBold" />
        </TextBlock>

        <TextBlock Text="{res:Text CreateServer_TypeLabel}" Style="{StaticResource FieldLabel}" />
        <ListBox ItemsSource="{Binding ServerTypes}"
                 SelectedItem="{Binding SelectedType}"
                 IsEnabled="{Binding IsIdle}"
                 AutomationProperties.Name="{res:Text CreateServer_TypeLabel}"
                 Background="{DynamicResource CardBrush}"
                 BorderThickness="1"
                 Padding="4">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
              <Setter Property="Padding" Value="10,7" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{res:Text CreateServer_VersionLabel}" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Id"
                  IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{res:Text CreateServer_VersionLabel}" />

        <TextBlock Text="{res:Text Change_Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0" />

        <TextBlock Text="{res:Text Change_Unchanged}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding IsUnchanged, Converter={StaticResource BoolToVisibility}}" />

        <!-- Going back to an older version: a plain warning and a second, deliberate tick. -->
        <Border Style="{StaticResource WarningBanner}" Margin="0,14,0,0"
                Visibility="{Binding ShowDowngradeWarning, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{res:Text Change_DowngradeWarning}" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding DowngradeAccepted}" IsEnabled="{Binding IsIdle}" Margin="0,10,0,0">
              <TextBlock Text="{res:Text Change_DowngradeAccept}" TextWrapping="Wrap" />
            </CheckBox>
          </StackPanel>
        </Border>

        <StackPanel Margin="0,18,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Image Style="{StaticResource BusyPeanut}" Width="20" Height="20" Margin="0,0,8,0" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                       AutomationProperties.Name="{Binding StatusText}" />
        </StackPanel>

        <Border Margin="0,14,0,0">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
