<UserControl x:Class="WaNut.App.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources"
             xmlns:controls="clr-namespace:WaNut.App.Controls">
  <!-- DataContext: ServerViewModel -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- A plain list: no selection or scrolling of its own, but each row is a list item screen readers can enter. -->
    <Style x:Key="PlainList" TargetType="ListBox">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ItemsPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="4,4,16,16">
      <!-- Online now -->
      <TextBlock Text="{res:Text Players_Online}" Style="{StaticResource Heading}" />
      <ItemsControl ItemsSource="{Binding Players}" Margin="0,0,0,4"
                    AutomationProperties.Name="{res:Text Players_Online}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="0,3">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="{Binding}" FontSize="14" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Players.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <controls:PixelScene Scene="no-players" Width="48" Height="48" Margin="0,0,8,0" />
        <TextBlock Text="{res:Text Server_NoPlayers}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
      </StackPanel>

      <Border Margin="0,16,0,0">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding PlayerLists.NameError}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding PlayerLists.NameError}" TextWrapping="Wrap" />
      </Border>

      <Border Style="{StaticResource NoticeBanner}" Margin="0,16,0,0"
              Visibility="{Binding PlayerLists.HasPendingChanges, Converter={StaticResource Visible}}">
        <TextBlock Text="{res:Text Players_Pending}" TextWrapping="Wrap" />
      </Border>

      <!-- Whitelist -->
      <TextBlock Text="{res:Text Players_Whitelist}" Style="{StaticResource Heading}" Margin="0,24,0,8" />
      <CheckBox Content="{res:Text Players_WhitelistOn}" IsChecked="{Binding PlayerLists.WhitelistOn}"
                IsEnabled="{Binding PlayerLists.CanChangeWhitelistSwitch}" Margin="0,0,0,10" />
      <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,10"
              Visibility="{Binding PlayerLists.ShowEmptyWhitelistWarning, Converter={StaticResource Visible}}">
        <TextBlock Text="{res:Text Players_WhitelistEmpty}" TextWrapping="Wrap" />
      </Border>
      <ContentControl Content="{Binding PlayerLists}">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <StackPanel>
              <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Whitelist}" AutomationProperties.Name="{res:Text Players_Whitelist}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,2">
                      <Button DockPanel.Dock="Right" Content="{res:Text Players_Remove}" Padding="10,3"
                              AutomationProperties.Name="{Binding RemoveLabel}"
                              Command="{Binding DataContext.RemoveFromWhitelistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}" />
                      <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Whitelist.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <controls:PixelScene Scene="empty-list" Width="32" Height="32" Margin="0,0,8,0" />
                <TextBlock Text="{res:Text Players_EmptyList}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
              </StackPanel>
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="{res:Text Players_Add}" Command="{Binding AddToWhitelistCommand}"
                        AutomationProperties.Name="{res:Text Players_AddToWhitelist}" MinWidth="72" Margin="8,0,0,0" />
                <TextBox Text="{Binding NewWhitelistName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"
                         Tag="{res:Text Players_NamePlaceholder}" AutomationProperties.Name="{res:Text Players_AddToWhitelist}"
                         InputMethod.IsInputMethodEnabled="False">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddToWhitelistCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
              </DockPanel>

              <!-- Operators -->
              <TextBlock Text="{res:Text Players_Operators}" FontSize="15" FontWeight="SemiBold" Margin="0,28,0,4" />
              <TextBlock Text="{res:Text Players_OperatorsHint}" Style="{StaticResource MutedText}" FontSize="12"
                         TextWrapping="Wrap" Margin="0,0,0,8" />
              <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Operators}" AutomationProperties.Name="{res:Text Players_Operators}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,2">
                      <Button DockPanel.Dock="Right" Content="{res:Text Players_Remove}" Padding="10,3"
                              AutomationProperties.Name="{Binding RemoveLabel}"
                              Command="{Binding DataContext.RemoveOperatorCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}" />
                      <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Operators.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <controls:PixelScene Scene="empty-list" Width="32" Height="32" Margin="0,0,8,0" />
                <TextBlock Text="{res:Text Players_EmptyList}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
              </StackPanel>
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="{res:Text Players_Add}" Command="{Binding AddOperatorCommand}"
                        AutomationProperties.Name="{res:Text Players_AddOperator}" MinWidth="72" Margin="8,0,0,0" />
                <TextBox Text="{Binding NewOperatorName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"
                         Tag="{res:Text Players_NamePlaceholder}" AutomationProperties.Name="{res:Text Players_AddOperator}"
                         InputMethod.IsInputMethodEnabled="False">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddOperatorCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
              </DockPanel>
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <Expander Header="{res:Text Settings_MoreSettings}" Margin="-4,24,0,0">
        <TextBlock Text="{res:Text Players_KickBanHint}" Style="{StaticResource Hint}" Margin="4,0,0,0" />
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
