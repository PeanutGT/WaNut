<UserControl x:Class="WaNut.App.Views.GuideOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:WaNut.App.Resources"
             xmlns:controls="clr-namespace:WaNut.App.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <!-- DataContext: GuideViewModel. The transparent background keeps clicks off the window while the peanut talks. -->
  <Grid Background="Transparent" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
    <Grid.InputBindings>
      <KeyBinding Key="Escape" Command="{Binding SkipCommand}" />
    </Grid.InputBindings>

    <Path x:Name="Dim" Fill="{DynamicResource GuideDimBrush}" />
    <Border x:Name="Ring" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="8" />

    <Border x:Name="Bubble" HorizontalAlignment="Left" VerticalAlignment="Top" Width="340"
            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="16"
            KeyboardNavigation.TabNavigation="Cycle"
            AutomationProperties.Name="{Binding Title}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
          <Button DockPanel.Dock="Left" Content="{res:Text Guide_Skip}" Command="{Binding SkipCommand}" />
          <Button x:Name="NextButton" DockPanel.Dock="Right" Content="{Binding NextText}" Command="{Binding NextCommand}"
                  Style="{StaticResource PrimaryButton}" MinWidth="80" Margin="8,0,0,0" />
          <Button DockPanel.Dock="Right" Content="{res:Text Guide_Back}" Command="{Binding BackCommand}"
                  Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding StepText}" Style="{StaticResource MutedText}" FontSize="12"
                     VerticalAlignment="Center" Margin="0,0,10,0" />
        </DockPanel>
        <controls:PixelScene DockPanel.Dock="Left" Scene="{Binding Current.Scene}" Width="48" Height="48"
                             VerticalAlignment="Top" Margin="0,0,12,0" />
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,6,0,0"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
