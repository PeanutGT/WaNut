<Window x:Class="WaNut.App.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WaNut.App.Resources"
        Title="{res:Text AppSettings_Title}"
        Icon="pack://application:,,,/Assets/wanut.ico"
        Style="{StaticResource AppWindow}"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <!-- DataContext: AppSettingsViewModel -->
  <StackPanel Margin="24">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
      <Image Style="{StaticResource Peanut}" Width="28" Height="28" Margin="0,0,10,0" />
      <TextBlock Text="{res:Text AppSettings_Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Look -->
    <TextBlock Text="{res:Text AppSettings_Theme}" Style="{StaticResource SectionCaption}" Margin="0,0,0,10" />
    <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Value" SelectedValuePath="Key"
              SelectedValue="{Binding Theme}" HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,18"
              AutomationProperties.Name="{res:Text AppSettings_Theme}" />

    <!-- Updates -->
    <TextBlock Text="{res:Text Update_Section}" Style="{StaticResource SectionCaption}" Margin="0,0,0,10" />
    <StackPanel x:Name="UpdatePanel">
      <!-- DataContext: UpdateViewModel -->
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{res:Text Update_CheckNow}" Command="{Binding CheckNowCommand}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                 AutomationProperties.LiveSetting="Polite">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
    <CheckBox Content="{res:Text Update_CheckOnStart}" IsChecked="{Binding CheckForUpdates}" Margin="0,10,0,0" />
    <TextBlock Text="{res:Text Update_CheckOnStartHint}" Style="{StaticResource MutedText}"
               FontSize="12" TextWrapping="Wrap" Margin="26,2,0,18" />

    <Expander Header="{res:Text Settings_MoreSettings}" Margin="-4,0,0,18">
      <StackPanel x:Name="ServersFolderPanel" Margin="4,8,0,0">
        <!-- DataContext: ServersFolderViewModel -->
        <TextBlock Text="{res:Text Setup_ServersFolder}" Margin="0,0,0,6" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{res:Text ServersFolder_Move}" Command="{Binding MoveCommand}" Margin="8,0,0,0" />
          <Button DockPanel.Dock="Right" Content="{res:Text ServersFolder_Open}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
          <TextBox Text="{Binding InstancesDir, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{res:Text ServersFolder_Hint}" Style="{StaticResource MutedText}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                   AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Border Margin="0,8,0,0">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Expander>

    <TextBlock Text="{res:Text Settings_AdvancedSection}" Style="{StaticResource SectionCaption}" Margin="0,0,0,10" />
    <CheckBox Content="{res:Text AppSettings_AdvancedMode}" IsChecked="{Binding AdvancedMode}" />
    <TextBlock Text="{res:Text AppSettings_AdvancedModeHint}" Style="{StaticResource MutedText}"
               FontSize="12" TextWrapping="Wrap" Margin="26,2,0,0" />

    <Border Margin="0,14,0,0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
    </Border>

    <Button Content="{res:Text Common_Close}" IsCancel="True" IsDefault="True"
            HorizontalAlignment="Right" MinWidth="80" Margin="0,24,0,0" />
  </StackPanel>
</Window>
