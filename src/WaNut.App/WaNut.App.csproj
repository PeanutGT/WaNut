<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WaNut</AssemblyName>
    <RootNamespace>WaNut.App</RootNamespace>
    <ApplicationIcon>Assets\wanut.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's install and update hooks before the WPF app starts. -->
    <StartupObject>WaNut.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\wanut.ico" />
    <Resource Include="Assets\peanut-16.png" />
    <Resource Include="Assets\Scenes\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaNut.Core\WaNut.Core.csproj" />
  </ItemGroup>

</Project>
