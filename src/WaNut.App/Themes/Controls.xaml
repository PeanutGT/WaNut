<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:WaNut.App.Behaviors">
  <!--
    Control styles for both themes. Colors always come from DynamicResource, so switching between
    Light.xaml and Dark.xaml restyles every open window. Rules from docs/design.md: 6px corners,
    green only for the one primary button, the selected tab and the Online state.
  -->

  <CornerRadius x:Key="ControlRadius">6</CornerRadius>

  <!-- 16x16, always shown at 48px (3x). -->
  <BitmapImage x:Key="PeanutBitmap" UriSource="pack://application:,,,/Assets/peanut-16.png" />

  <!-- The mark next to "done" and "all good" messages; it pops in when it appears. -->
  <Style x:Key="SuccessMark" TargetType="Path">
    <Setter Property="Data" Value="M 3 9.5 L 7.5 14 L 15 5" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="2.5" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="behaviors:Bounce.OnAppear" Value="True" />
  </Style>

  <!--
    Color feedback. A theme brush cannot be animated towards another theme brush, so each state is a layer
    named Hover, Selected or Fill that fades in over the resting look. Templates start these from their triggers.
  -->
  <!-- For a layer that fades by its own style triggers, e.g. the colors of the status pill. -->
  <Storyboard x:Key="FadeIn">
    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                     Duration="{StaticResource MotionTransition}" EasingFunction="{StaticResource MotionEase}" />
  </Storyboard>
  <Storyboard x:Key="FadeOut">
    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                     Duration="{StaticResource MotionTransition}" EasingFunction="{StaticResource MotionEase}" />
  </Storyboard>
  <Storyboard x:Key="ShowHover">
    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1"
                     Duration="{StaticResource MotionFeedback}" EasingFunction="{StaticResource MotionEase}" />
  </Storyboard>
  <Storyboard x:Key="HideHover">
    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0"
                     Duration="{StaticResource MotionFeedback}" EasingFunction="{StaticResource MotionEase}" />
  </Storyboard>
  <Storyboard x:Key="ShowSelected">
    <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1"
                     Duration="{StaticResource MotionFeedback}" EasingFunction="{StaticResource MotionEase}" />
  </Storyboard>
  <Storyboard x:Key="HideSelected">
    <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0"
                     Duration="{StaticResource MotionFeedback}" EasingFunction="{StaticResource MotionEase}" />
  </Storyboard>
  <Storyboard x:Key="ShowFill">
    <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1"
                     Duration="{StaticResource MotionFeedback}" EasingFunction="{StaticResource MotionEase}" />
  </Storyboard>
  <Storyboard x:Key="HideFill">
    <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0"
                     Duration="{StaticResource MotionFeedback}" EasingFunction="{StaticResource MotionEase}" />
  </Storyboard>

  <!-- Keyboard focus ring, shared by every control. -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource MutedTextBrush}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Windows -->
  <Style x:Key="AppWindow" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Window">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <AdornerDecorator>
                <ContentPresenter />
              </AdornerDecorator>
              <!-- Small questions open here, over the window's content (InlinePanel). -->
              <Grid x:Name="PanelLayer" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The box of a panel shown inside a window. -->
  <Style x:Key="PanelCard" TargetType="Border">
    <!-- Up to 420 wide; narrower in a small window. -->
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="MinWidth" Value="300" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- The pixel peanut. Always scaled with nearest neighbor so the pixels stay sharp. -->
  <Style x:Key="Peanut" TargetType="Image">
    <Setter Property="Source" Value="{StaticResource PeanutBitmap}" />
    <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!-- The peanut wobbling while something is in progress (starting, saving, downloading). -->
  <Style x:Key="BusyPeanut" TargetType="Image" BasedOn="{StaticResource Peanut}">
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <RotateTransform Angle="-12" />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                             From="-12" To="12" Duration="0:0:0.45"
                             AutoReverse="True" RepeatBehavior="Forever">
              <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="MutedText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>

  <Style x:Key="SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Banners: light background, matching text and a thin border, next to the content they are about. -->
  <Style x:Key="ErrorBanner" TargetType="Border">
    <Setter Property="behaviors:Reveal.IsEnabled" Value="True" />
    <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ErrorTextBrush}" />
  </Style>

  <Style x:Key="WarningBanner" TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>

  <!-- Neutral note, e.g. "Stop the server to change these settings." -->
  <Style x:Key="NoticeBanner" TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>

  <!-- Buttons: secondary by default (card + border), PrimaryButton for the one green action. -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="behaviors:Surface.HoverBrush" Value="{DynamicResource HoverBrush}" />
    <Setter Property="behaviors:Surface.EdgeBrush" Value="{DynamicResource ButtonEdgeBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <!-- The hard edge: the face sits 3px above the bottom and drops onto it while pressed. -->
            <Border Background="{TemplateBinding behaviors:Surface.EdgeBrush}"
                    CornerRadius="{StaticResource ControlRadius}" />
            <Border x:Name="Face" Margin="0,0,0,3"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource ControlRadius}">
              <Grid>
                <Border x:Name="Hover" Opacity="0" CornerRadius="5"
                        Background="{TemplateBinding behaviors:Surface.HoverBrush}" />
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource ShowHover}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HideHover}" />
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="3" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="behaviors:Surface.HoverBrush" Value="{DynamicResource PrimaryButtonHoverBrush}" />
    <Setter Property="behaviors:Surface.EdgeBrush" Value="{DynamicResource PrimaryButtonEdgeBrush}" />
  </Style>

  <!-- "+ Create server" at the bottom of the sidebar. -->
  <Style x:Key="DashedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <!-- Under the dashes, so the outline stays visible while the hover layer is in. -->
            <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource ControlRadius}"
                    Background="{TemplateBinding behaviors:Surface.HoverBrush}" />
            <Rectangle RadiusX="6" RadiusY="6"
                       Fill="{TemplateBinding Background}"
                       Stroke="{TemplateBinding BorderBrush}"
                       StrokeThickness="1" StrokeDashArray="4 3" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource ShowHover}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HideHover}" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Text boxes. Tag holds the placeholder text shown while the box is empty. -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource ControlRadius}"
                  SnapsToDevicePixels="True">
            <Grid Margin="{TemplateBinding Padding}">
              <!-- WPF also indents the typed text by Padding inside the content host, so the hint gets the same indent
                   and starts where the caret and the first typed letter do. -->
              <Border Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                <TextBlock x:Name="Placeholder"
                           Text="{TemplateBinding Tag}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="3,0,0,0"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                           Visibility="Collapsed" />
              </Border>
              <ScrollViewer x:Name="PART_ContentHost"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Password box: same look as the text box -->
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Frame"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource ControlRadius}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Combo box -->
  <Style x:Key="ComboBoxToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Frame"
                  Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource ControlRadius}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Hover" Opacity="0" CornerRadius="5" Background="{DynamicResource HoverBrush}" />
              <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                    Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource ShowHover}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HideHover}" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="12,6,24,6" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboBoxToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom" VerticalOffset="4"
                   AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource ControlRadius}"
                      Padding="3">
                <ScrollViewer SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="6,6" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid Background="Transparent">
            <Border x:Name="Hover" Opacity="0" CornerRadius="4" Background="{DynamicResource HoverBrush}" />
            <Border x:Name="Selected" Opacity="0" CornerRadius="4" Background="{DynamicResource SelectedItemBrush}" />
            <ContentPresenter Margin="{TemplateBinding Padding}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource ShowHover}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HideHover}" />
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource ShowSelected}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HideSelected}" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lists -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <!-- Keeps long lists virtualized: only the visible rows are created. -->
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource ControlRadius}"
                  Padding="{TemplateBinding Padding}">
            <ScrollViewer Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource ControlRadius}"
                    Background="{DynamicResource HoverBrush}" />
            <Border x:Name="Selected" Opacity="0" CornerRadius="{StaticResource ControlRadius}"
                    Background="{DynamicResource SelectedItemBrush}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource ShowHover}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HideHover}" />
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource ShowSelected}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HideSelected}" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A console line: plain text, not selectable or focusable, so the console reads like a terminal. -->
  <Style x:Key="ConsoleLine" TargetType="ListBoxItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter Margin="0,0" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tabs: plain text, the selected one dark with a green underline. -->
  <Style TargetType="TabControl">
    <Setter Property="behaviors:TabIndicator.IsEnabled" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel KeyboardNavigation.TabNavigation="Local">
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <!-- A WrapPanel, not TabPanel: TabPanel ignores the tabs' margins and squeezes their text when the window is narrow.
                   Here a tab that does not fit moves to a second row whole. -->
              <Grid>
                <WrapPanel IsItemsHost="True" />
                <!-- The selection line; TabIndicator slides it under the selected tab. -->
                <Rectangle x:Name="Indicator" Height="2" Width="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Fill="{DynamicResource AccentBrush}" IsHitTestVisible="False" Visibility="Hidden" />
              </Grid>
            </Border>
            <!-- The name lets screen readers and UI Automation reach the selected tab's content. -->
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,12,0,0"
                              behaviors:ContentTransition.Trigger="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}}" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <!-- The gap sits outside the tab so the tab's bounds (the guide's ring, the focus ring) hug its text. -->
    <Setter Property="Margin" Value="0,0,24,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <!-- The transparent bottom border keeps room for the tab control's selection line.
               The header's size and weight are set here, not on the tab: the tab's content inherits from the tab,
               and its text stays body size and weight (docs/design.md, section 5). -->
          <Border x:Name="Header" Padding="0,6,0,6" TextElement.FontSize="{StaticResource FontSubheading}"
                  BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Check box -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,0,0,0">
              <Border x:Name="Box" CornerRadius="4"
                      Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
              <!-- The checked look, mark included, fades in over the empty box. -->
              <Border x:Name="Fill" Opacity="0" CornerRadius="4" Background="{DynamicResource TextBrush}"
                      BorderBrush="{DynamicResource TextBrush}" BorderThickness="1">
                <Path Data="M 3.5 8.5 L 7 12 L 14 4.5" Stroke="{DynamicResource CardBrush}" StrokeThickness="2" />
              </Border>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource ShowFill}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HideFill}" />
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Radio button: same look as the check box, with a round box and a dot. -->
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,0,0,0">
              <Border x:Name="Box" CornerRadius="9"
                      Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
              <Border x:Name="Fill" Opacity="0" CornerRadius="9" Background="{DynamicResource TextBrush}">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource CardBrush}" />
              </Border>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource ShowFill}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HideFill}" />
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Expander: "More settings" on each settings page. A chevron and the header; the content opens below. -->
  <Style x:Key="ExpanderHeader" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Background="Transparent">
            <Border x:Name="Hover" Opacity="0" CornerRadius="{StaticResource ControlRadius}" Background="{DynamicResource HoverBrush}" />
            <StackPanel Orientation="Horizontal" Margin="3,6">
              <!-- Points right when closed, down when open. -->
              <Path x:Name="Chevron" Data="M 3 0 L 8 5 L 3 10" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.6"
                    Width="10" Height="10" VerticalAlignment="Center" />
              <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource ShowHover}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource HideHover}" />
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chevron" Property="Data" Value="M 0 3 L 5 8 L 10 3" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <!-- The header button shows keyboard focus; a second box around the whole open section only looks stray. -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Top" HorizontalAlignment="Left"
                          Style="{StaticResource ExpanderHeader}"
                          Content="{TemplateBinding Header}"
                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter x:Name="Body" Margin="0,6,0,0" Visibility="Collapsed" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- Slider -->
  <Style x:Key="SliderTrackPart" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid MinHeight="22">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderTrackPart}" Command="Slider.DecreaseLarge" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderTrackPart}" Command="Slider.IncreaseLarge" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="18" Height="18" Cursor="Hand">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Fill="{DynamicResource TextBrush}" Stroke="{DynamicResource CardBrush}" StrokeThickness="2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Progress bar, with a sliding block while the length of the work is unknown. -->
  <Style TargetType="ProgressBar">
    <Setter Property="behaviors:SmoothProgress.IsEnabled" Value="True" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track" ClipToBounds="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
            <!-- Not PART_Indicator: SmoothProgress sets the width, so it can glide. -->
            <Border x:Name="Fill" Width="0" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
            <Border x:Name="Slider" Width="80" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                    CornerRadius="3" Visibility="Collapsed">
              <Border.RenderTransform>
                <TranslateTransform X="-80" />
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Slider" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Sliding">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="RenderTransform.X"
                                     From="-80" To="480" Duration="0:0:1.4" RepeatBehavior="Forever" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Sliding" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin scroll bars without arrows. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="3" Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource ScrollThumbBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,3">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource SliderTrackPart}" Command="ScrollBar.PageUpCommand" />
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource SliderTrackPart}" Command="ScrollBar.PageDownCommand" />
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumb}" Background="{TemplateBinding Foreground}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Margin="3,0">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SliderTrackPart}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SliderTrackPart}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" Background="{TemplateBinding Foreground}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="6,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
