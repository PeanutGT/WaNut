<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Every animation in the app takes its time and curve from here (docs/design.md, section 6); views never write
    their own. MotionSettings sets the durations to zero when Windows has animation effects turned off.
  -->

  <!-- Crisp: feedback on hover, press, check and selection. -->
  <Duration x:Key="MotionFeedback">0:0:0.1</Duration>
  <!-- Crisp: content that changes place, e.g. tabs, banners and panels. -->
  <Duration x:Key="MotionTransition">0:0:0.18</Duration>
  <!-- Fast start, soft stop, no overshoot. -->
  <CubicEase x:Key="MotionEase" EasingMode="EaseOut" />

  <!-- Bounce: only the peanut and the success moments listed in docs/design.md. -->
  <Duration x:Key="MotionBounce">0:0:0.32</Duration>
  <BackEase x:Key="MotionBounceEase" EasingMode="EaseOut" Amplitude="0.5" />
</ResourceDictionary>
