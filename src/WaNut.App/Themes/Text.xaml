<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    The four text sizes (docs/design.md, section 5). Screens write FontSize="{StaticResource FontSmall}" and never
    a number; DesignRulesTests fails on a literal size.
  -->
  <!-- Captions, hints and the console. -->
  <sys:Double x:Key="FontSmall">12</sys:Double>
  <!-- Body text; the default of every window. -->
  <sys:Double x:Key="FontBody">13</sys:Double>
  <!-- Tabs, list item names and messages in small dialogs. -->
  <sys:Double x:Key="FontSubheading">15</sys:Double>
  <!-- Window and page titles, the server name. -->
  <sys:Double x:Key="FontTitle">21</sys:Double>

  <!-- Body text: Segoe UI, with Microsoft JhengHei named for Chinese so it does not depend on the PC's fallback. -->
  <FontFamily x:Key="BodyFont">Segoe UI, Microsoft JhengHei</FontFamily>
  <!--
    Titles and server names: Chiron GoRound TC Bold, bundled in Assets/Fonts (SIL OFL 1.1, license next to it).
    Only the Bold face is bundled, so text in this font is always bold.
  -->
  <FontFamily x:Key="HeadingFont">pack://application:,,,/Assets/Fonts/#Chiron GoRound TC, Segoe UI, Microsoft JhengHei</FontFamily>
</ResourceDictionary>
